# Optional local overrides for development convenience.
# StudioFlow CLI does not require a .env file.
# Runtime defaults should be configured via:
# - .studioflow/config.json (project)
# - ~/.studioflow/config.json (user)
# - CLI flags on `studioflow run`

# Sample app settings
SAMPLE_APP_PORT=4173

# Screen Studio controls
SCREENSTUDIO_APP_NAME=Screen Studio
SCREENSTUDIO_PRE_CONFIRM_DELAY_MS=800
SCREENSTUDIO_POST_START_DELAY_MS=1200
SCREENSTUDIO_POST_STOP_DELAY_MS=800
SCREENSTUDIO_EXPORT_DIALOG_CONFIRM_DELAY_MS=800
SCREENSTUDIO_EXPORT_DELAY_MS=2500

# Optional persistent data root for learned flows/candidates/setup state.
# Default: ~/.studioflow
# STUDIOFLOW_DATA_DIR=/absolute/path/to/studioflow-data

# Demo realism controls
STUDIOFLOW_RENDER_CURSOR=true
STUDIOFLOW_CURSOR_MOVE_MS=320
STUDIOFLOW_CURSOR_HIGHLIGHT_MS=120
STUDIOFLOW_REALISTIC_TYPING=true
STUDIOFLOW_TYPING_DELAY_MS=35
STUDIOFLOW_PACING_ADJUSTMENT=true
STUDIOFLOW_PACING_JITTER=true
