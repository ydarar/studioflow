# Sample app settings
SAMPLE_APP_PORT=4173

# Screen Studio controls
SCREENSTUDIO_APP_NAME=Screen Studio
SCREENSTUDIO_PRE_CONFIRM_DELAY_MS=800
SCREENSTUDIO_POST_START_DELAY_MS=1200
SCREENSTUDIO_POST_STOP_DELAY_MS=800
SCREENSTUDIO_EXPORT_DIALOG_CONFIRM_DELAY_MS=800
SCREENSTUDIO_EXPORT_DELAY_MS=2500

# Runner settings
DEMOPILOT_RUNS_DIR=.runs
DEMOPILOT_HEADLESS=false
DEMOPILOT_BASE_URL=http://localhost:4173
DEMOPILOT_START_COMMAND=pnpm --filter @demopilot/sample-app dev

# Demo realism controls
DEMOPILOT_RENDER_CURSOR=true
DEMOPILOT_CURSOR_MOVE_MS=320
DEMOPILOT_CURSOR_HIGHLIGHT_MS=120
DEMOPILOT_REALISTIC_TYPING=true
DEMOPILOT_TYPING_DELAY_MS=35
DEMOPILOT_PACING_ADJUSTMENT=true
DEMOPILOT_PACING_JITTER=true
