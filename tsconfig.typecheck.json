{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@studioflow/*": ["packages/*/src/index.ts"],
      "playwright": ["packages/adapters-playwright/node_modules/playwright"]
    }
  },
  "include": [
    "apps/cli/src/**/*.ts",
    "packages/**/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".runs",
    "artifacts",
    "artifacts-test",
    "apps/sample-app/.next"
  ]
}
