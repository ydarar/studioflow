{
  "name": "studioflow",
  "private": true,
  "version": "0.1.0",
  "description": "Deterministic AI-assisted product demo automation with Screen Studio",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev:sample": "pnpm --filter @studioflow/sample-app run dev",
    "demo": "pnpm --filter @ydarar/studioflow run demo --",
    "setup": "pnpm --filter @ydarar/studioflow run setup --",
    "install-skills": "pnpm --filter @ydarar/studioflow run install-skills --",
    "discover": "pnpm --filter @ydarar/studioflow run discover --",
    "bootstrap": "pnpm --filter @ydarar/studioflow run bootstrap --",
    "screenstudio-prep": "pnpm --filter @ydarar/studioflow run screenstudio-prep --",
    "plan": "pnpm --filter @ydarar/studioflow run plan --",
    "validate": "pnpm --filter @ydarar/studioflow run validate --",
    "replay": "pnpm --filter @ydarar/studioflow run replay --",
    "promote": "pnpm --filter @ydarar/studioflow run promote --",
    "doctor": "pnpm --filter @ydarar/studioflow run doctor",
    "list-flows": "pnpm --filter @ydarar/studioflow run list-flows",
    "list-candidates": "pnpm --filter @ydarar/studioflow run list-candidates",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:ci": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
